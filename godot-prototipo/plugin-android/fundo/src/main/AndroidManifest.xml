<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voltar do segundo plano (André 2026-11-17): com o jogo no fundo, um serviço na frente segura o app vivo por
         até 10 min, para o Android não fechar a partida enquanto ele vê uma mensagem -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <meta-data android:name="org.godotengine.plugin.v2.FundoJogo" android:value="com.rcandrerc.fundo.FundoJogo" />
        <service
            android:name="com.rcandrerc.fundo.ServicoFundo"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantém a partida online aberta por alguns minutos enquanto o jogador vê outro app" />
        </service>
        <!-- Robô nos celulares de verdade (2026-11-18): o Firebase Test Lab no modo "game loop" abre o jogo por esta porta
             (TEST_LOOP) e deixa jogar o tempo todo; o modo "robo" encerrava o teste em ~3 min. O GodotApp do Godot 4.7
             não é exportado, então a porta é um apelido exportado dele, sem ícone: o jogador não vê nada. Vem no AAR
             (a biblioteca entra no manifesto depois da tela do jogo, como o Android exige para um apelido). -->
        <activity-alias
            android:name="com.rcandrerc.fundo.TesteLoop"
            android:targetActivity="com.godot.game.GodotApp"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.intent.action.TEST_LOOP" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/javascript" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
