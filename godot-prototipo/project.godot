; Protótipo Godot: mesma vila e personagens anime do jogo HTML, para comparar FPS no celular.
config_version=5

[application]
config/name="RPG Prototipo Godot"
run/main_scene="res://inicio.tscn"
config/icon="res://icone_app/principal_192.png"
config/features=PackedStringArray("4.7", "Mobile")
config/project_settings_override="user://motor.cfg"
boot_splash/bg_color=Color(0.05, 0.06, 0.09, 1)
boot_splash/image="res://ui/abertura.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=576
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="mobile"
driver/threads/thread_model=2
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[threading]

; Godot 4.7: com uma linha por núcleo a 1ª abertura (shaders) travava. Ver grafico.gd ajustar_linhas.
worker_pool/max_threads=32

[input_devices]

pointing/emulate_touch_from_mouse=true

[editor_plugins]

enabled=PackedStringArray("res://addons/volta_login/plugin.cfg", "res://addons/login_google/plugin.cfg")

[gui]

theme/custom_font="res://fontes/AlegreyaSans-Bold.ttf"
